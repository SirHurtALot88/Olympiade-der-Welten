# dependencies
# Ohne Schraegstrich, damit auch ein SYMLINK dieses Namens greift: Wer mit `git worktree`
# arbeitet, verlinkt node_modules ueblicherweise ins Hauptverzeichnis. `node_modules/` traf
# nur das Verzeichnis — der Symlink rutschte durch `git add -A` in den Baum und lag danach
# als toter Pfad auf main (siehe #302).
node_modules

# Next.js / build output
.next/
.next-dev/
.turbo/
out/
dist/
build/
coverage/

# local runtime data and generated reports
tmp/
.cache/
test-results/
playwright-report/
outputs/
reports/
backups/

# scripts/export-team-principal-mod.mjs erzeugt Team-Logo-/Fahrer-Portrait-PNGs neben
# teams.json/drivers.json -- die JSONs bleiben versioniert, aber hunderte Bilddateien
# (~130 MB) gehoeren nicht ins Git (s. CLAUDE.md "Deploy": genau dieses Bloat-Problem
# hat den Server schon einmal per vollem Root-Volume lahmgelegt).
data/generated/team-principal-mod/logos/
data/generated/team-principal-mod/portraits/

# local databases / saves
*.sqlite
*.sqlite3
*.db
*.db-journal
data/local-dev.sqlite
data/persistence/
data/persistence/*.sqlite
# Sicherungen, die die Reparaturskripte vor jedem Schreiblauf anlegen (--apply). Sie gehoeren zu der
# Maschine, auf der repariert wurde, nicht ins Repo: es sind vollstaendige Spielstaende, je ~40 MB.
data/save-backups/

# environment files with secrets
.env
.env.*
!.env.example
!.env.reference.example

# TypeScript / logs
*.tsbuildinfo
*.tsbuildinfo-*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/

# Codex scratch artifacts
.codex-temp-*

# Bulk-import staging for team logos (originals; renamed copies get committed)
public/team-logos-src/

# Local balancing/diagnostic run artifacts (temp, do not commit)
scratchpad/

# Claude Code agent worktrees (transient, harness-managed)
.claude/worktrees/

# Wegwerf-Diagnoseskripte (Playwright-Proben o. Ä.), muessen im Projektordner liegen
# damit node die Pakete aufloest — gehoeren aber nie ins Repo.
_probe*.mjs
_probe*.ts

scripts/_tmp-*.ts
