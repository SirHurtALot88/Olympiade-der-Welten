{$OLY_DOMAIN} {
	# Kompression sitzt hier, nicht in Next (next.config.ts: compress:false) -- Caddy kann zstd,
	# Next nur gzip. Standard-Match = nur komprimierbare Typen (text/*, JS, JSON, SVG, Fonts ...);
	# PNG/MP3 bleiben unangetastet. Brotli ist im Standard-Image `caddy:2` NICHT enthalten.
	encode zstd gzip
	reverse_proxy oly-app:3000
}

# Lord Enterich Cards — eigene Subdomain, getrennt von der Oly (KONZEPT §4.2).
# Caddy holt/erneuert das HTTPS-Zertifikat automatisch. Die LEC-App bringt
# ihren eigenen Login mit; hier keine zusaetzliche Auth noetig.
{$LEC_DOMAIN} {
	reverse_proxy lec-app:3000
}

