OLY_DOMAIN=deine-domain.de

# --- Phase-1-Login (optional, standardmaessig AUS) ---------------------------
# Schalter fuer den Login: "1" aktiviert Login-Pflicht + Identitaets-Verdrahtung
# (Chris sieht seine Teams, Franky seine). Leer/unset lassen, um den Login
# ausgeschaltet zu lassen - die App laeuft dann wie bisher ohne Anmeldung.
OLY_AUTH_ENABLED=

# Geheimer Schluessel zum Signieren der Session-Cookies. Zufaelligen, langen
# String erzeugen (z. B. `openssl rand -hex 32`) und geheim halten. Sobald
# OLY_AUTH_ENABLED=1 gesetzt ist, ist dieser Wert auf dem Server PFLICHT.
OLY_AUTH_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen

# Passwoerter fuer die zwei festen Benutzer Chris und Franky. Sobald
# OLY_AUTH_ENABLED=1 gesetzt ist, sind diese Werte auf dem Server PFLICHT -
# ohne sie schlaegt der Login fehl (kein unsicherer Default in Produktion).
OLY_USER_CHRIS_PASSWORD=bitte-echtes-passwort-setzen
OLY_USER_FRANKY_PASSWORD=bitte-echtes-passwort-setzen
OLY_USER_RAMONA_PASSWORD=bitte-echtes-passwort-setzen

# --- Lord Enterich Cards (LEC) ----------------------------------------------
# Eigene Subdomain, getrennt von der Oly. Caddy macht HTTPS automatisch.
LEC_DOMAIN=leccards.duckdns.org

# Zugangsschutz LEC (Single-User "Chris"). In Produktion ist der Login an
# (LEC_AUTH_ENABLED default 1 im compose). Beide Werte sind dann PFLICHT -
# ohne sie sperrt sich die App (fail closed, kein unsicherer Default).
# Session-Cookie ist langlebig (~1 Jahr): einmal pro Geraet anmelden.
LEC_AUTH_ENABLED=1
LEC_PASSWORD=bitte-echtes-passwort-setzen
LEC_AUTH_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen


# Arena-Vorlauf (optional, PR #1290): die zwei Liga-Stufen einer Arena-Disziplin koennten
# gleichzeitig laufen (zwei Chromium-Prozesse, lokal ~2 GB RAM). Standard jetzt "0" (seriell,
# Nachtrag 25.10. zum Chromium-Produktions-Image, PR #1270/#160): auf einem 3,8-GB-Server mit knapp
# unter der 2048-MB-Guard-Schwelle liegendem "available" wiegt ein ganzer gesparter Browser-Prozess
# (~770-790 MB) mehr als der Geschwindigkeitsgewinn durch Parallelbetrieb. Auf "1" setzen, um wieder
# parallel zu fahren (z. B. nach einem RAM-Upgrade). Unabhaengig davon faellt der Code automatisch auf
# seriell zurueck, wenn beim Start weniger als OLY_ARENA_TIER_PARALLEL_MIN_FREE_MB (Standard 2048)
# frei sind; 0 schaltet diese Pruefung ab. Wirkt erst nach einem Neustart des oly-app-Containers
# (z. B. naechster Deploy).
OLY_ARENA_TIER_PARALLEL=0
OLY_ARENA_TIER_PARALLEL_MIN_FREE_MB=

# Mini-DM-FFA-Rollback (optional, Opus-Review an PR 5 des 6-PR-Opus-Plans 21.10.,
# "Vorlauf-Verdrahtung"): OLY_MINI_DM_FFA_VORLAUF=aus schaltet den Mini-DM-FFA-Vorlauf ab, der
# Spieltag faellt dann vollstaendig auf den alten PPS-Pod-Pfad zurueck. Leer/jeder andere Wert =
# Code-Standard (AN). Wirkt erst, nachdem der Container mit DIESEM `.env` neu ERSTELLT wurde
# (`docker compose up -d` im Repo-Verzeichnis auf dem Server) -- ein blosser `docker restart
# oly-app` reicht NICHT, weil er die beim letzten `docker compose up` eingefrorene Umgebung
# weiterverwendet und `.env` dafuer nicht neu einliest. Bereits mit `quelle:"ffa"` fertiggestellte
# Spieltage buchen nach dem Abschalten trotzdem mit diesem Ergebnis weiter (Snapshot-vorher,
# buchen-nachher, wie jede andere Arena-Disziplin).
OLY_MINI_DM_FFA_VORLAUF=

# Wertungsskalen (18.11., docs/design/pp-skala-18-11.md Abschnitt 8.4): PP-Skala C2 und Ergebnisskala E1.
# Leer = Standard, neue Saisons rechnen mit den neuen Skalen. "aus" = Rueckweg: NEUE Saisons bekommen die
# alte Skala, bereits gestempelte Saisons rechnen wie gestempelt weiter. "aus-sofort" = Notbremse: ignoriert
# jeden Stempel, auch mitten in der Saison. Beide Werte reichen compose an den Container UND als Build-
# Argument an den Browser durch -- nach einer Aenderung also neu BAUEN, nicht nur neu starten
# (`docker compose up -d --build` im Repo-Verzeichnis auf dem Server).
OLY_PP_SKALA=
OLY_ERGEBNIS_SKALA=

# PP-Tagesanker (22.11., docs/design/pp-tagesanker-live-22-11.md): leer = neue Saisons verteilen die Spieler-PP je
# Disziplin und Spieltag ueber alle Spieler beider Ligen (Tagesbester um 5, kein Klumpen am Deckel). "aus" = Rueckweg:
# NEUE Saisons ohne, gestempelte Saisons rechnen wie gestempelt weiter. "aus-sofort" = Notbremse, ignoriert jeden
# Stempel. Wie die Skalen oben: nach einer Aenderung neu BAUEN.
OLY_PP_TAGESANKER=

# Climbing-Format (Canyon live, 18.11., docs/design/climbing-canyon-live-18-11.md): leer = Canyon (Standard).
# "standard" = Abschalt-Schalter: ab dem naechsten gewerteten Climbing-Spieltag wieder das alte Format; schon
# gebuchte Spieltage bleiben in dem Format, in dem sie gebucht wurden (Wechselliste im Spielstand,
# seasonState.climbingFormat). Wieder leeren schaltet ab dem naechsten Spieltag zurueck auf Canyon. Wie oben
# reicht compose den Wert an den Container UND als Build-Argument an den Browser -- neu BAUEN
# (`docker compose up -d --build` im Repo-Verzeichnis auf dem Server).
OLY_CLIMBING_FORMAT=

# Battlefield-Format (Fuenf-Punkte-Domination live, 22.11., docs/design/battlefield-5punkte-22-11.md): leer = fuenf
# Punkte mit Respawn und sinkenden HP (Standard). "alt" = Abschalt-Schalter: ab dem naechsten gewerteten Spieltag
# wieder das Gefecht je Ort (drei Orte); schon gebuchte Spieltage bleiben in ihrem Format (Wechselliste im
# Spielstand, seasonState.battlefieldFormat). Wie oben reicht compose den Wert an Container UND Browser -- neu BAUEN.
OLY_BATTLEFIELD_FORMAT=

# Hockey-Torwart-Regel (22.11., docs/design/hockey-torwart-22-11.md): leer = neue Regel (Standard): die Parade-Guete
# kommt zur Haelfte aus der Hockey-Eignung, jeder Schuss kostet Puste (Dauerfeuer), Gegentore zaehlen halb als
# erwartete Gegentore. "alt" = Abschalt-Schalter: ab dem naechsten gewerteten Spieltag wieder die alte Regel; schon
# gebuchte Spieltage bleiben bei ihrer Regel (Wechselliste im Spielstand, seasonState.hockeyTorwart). Wie oben reicht
# compose den Wert an Container UND Browser -- neu BAUEN.
OLY_HOCKEY_TORWART=

# Basketball-Puste (22.11., docs/design/basketball-puste-22-11.md): leer = neue Regel (Standard): jeder Spieler hat einen
# Puste-Vorrat aus AUSDAUER, verbraucht ihn beim Laufen und Ballfuehren, wird mit leerer Puste langsamer, schwaecher im
# Rebound und im Wurf und seltener angespielt; dazu ein Beteiligungsboden in der Pass-Lotterie. "alt" = Abschalt-Schalter:
# ab dem naechsten gewerteten Spieltag wieder die alte Regel; schon gebuchte Spieltage bleiben bei ihrer Regel (Wechselliste
# im Spielstand, seasonState.basketballPuste). Wie oben reicht compose den Wert an Container UND Browser -- neu BAUEN.
OLY_BASKETBALL_PUSTE=
# Wirtschafts-Regeln 22.11. (Review-Fixes): leer = neu; 0 oder aus = neue Saisons rechnen alt (Spielstand-Stempel, wirkt ab der naechsten Saison)
OLY_QUOTE_UEBER_PFLICHTKADER=
OLY_BOARD_ERWARTUNG_ANKER=
OLY_KI_KERNSCHUTZ=
# Startbudget-Staffel 22.11.: leer = neue Spiele bekommen +20 C (Platz 32) bis +82 C (Platz 1) auf die Startkasse; 0 oder aus = neue Spiele ohne Aufschlag (bestehende Spielstaende unberuehrt)
OLY_STARTBUDGET_STAFFEL=

# Formkarten Plus/Minus (22.11., docs/design/formkarten-plusminus-22-11.md): leer = Standard: Gegenfarbe, Kartenwerte 2/4/6/8, KI-Duellgewicht
# ab der naechsten Saison (neues Spiel: ab Saison 1; die Regel steht im Spielstand, seasonState.formkartenRegel). "aus" = Rueckweg
# (neue Saisons wieder mit der Regel von 18.11.), "aus-sofort" = Notbremse (Gegenfarbe und Duellgewicht aus, auch mitten in der Saison;
# die Kartenwerte bleiben). Nur Server, kein Build-Arg noetig; nach dem Setzen den Container neu starten.
OLY_FORMKARTEN_PLUSMINUS=

# Spielerentwicklung (22.11., docs/design/entwicklung-balance-22-11.md): leer = Standard: die Regel "neu" ab der naechsten Saison (neues Spiel:
# ab Saison 1; sie steht im Spielstand, seasonState.entwicklungsRegel). "alt" = Rueckweg: neue Saisons rechnen wieder wie vor dem 22.11.;
# schon gestempelte Saisons rechnen zu Ende wie gestempelt. Nur Server, kein Build-Arg noetig; nach dem Setzen den Container neu starten.
OLY_ENTWICKLUNG=

# Breaking-Format (22.11., docs/design/breaking-tagteam-22-11.md): leer = Tag-Team (Standard): 6 gegen 6, je Team einer im Ring,
# ein Gang = A peinigt / B haelt aus und umgekehrt, danach verdeckter Wechsel beider Teams; jeder kommt dran, Standzeit 2, Waffe frei
# waehlbar (genau eine je Gang). "alt" = Abschalt-Schalter: ab dem naechsten gewerteten Spieltag wieder der alte Gauntlet; schon
# gebuchte Spieltage bleiben bei ihrem Format (Wechselliste im Spielstand, seasonState.breakingFormat). Wie oben reicht compose den
# Wert an Container UND Browser -- neu BAUEN.
OLY_BREAKING_FORMAT=

# Ausruestung (22.11., docs/design/ausruestung-phase1a-22-11.md): leer = "besitz" (Standard): Lager mit 16 Plaetzen, Materialien, Teile,
# Ruhm aus Punkten, Truhen Holz/Eisen/Gold; Phase 1a beruehrt die Wertung NICHT. "aus" = ab dem naechsten gewerteten Spieltag aus (der
# Besitz bleibt im Spielstand liegen, gebuchte Spieltage behalten ihre Stufe). "aus-sofort" = Notbremse: sofort aus, auch fuer den
# laufenden Spieltag. Nur Server (compose + diese Datei), kein NEXT_PUBLIC; die Regel steht im Spielstand (seasonState.ausruestungRegel).
OLY_AUSRUESTUNG=

# Liga-Draft (Draft-Seite, 18.11., docs/design/draft-neubau-kern-18-11.md): leer = neuer Draft Pick fuer Pick mit Draft-Seite
# (KI pickt live, Top 3, Ueberspringen; Standard seit der Abnahme 19.11.), "block" = Rueckweg auf den alten Hintergrund-Draft. Wirkt nur beim
# Anlegen eines NEUEN Spiels; laufende Spielstaende bleiben unberuehrt. Reine Server-Variable (kein Build-Argument),
# `docker compose up -d` genuegt. Abnahme: docs/design/abnahme-saison-19-11.md.
OLY_LIGA_DRAFT_MODUS=
