OLY_DOMAIN=deine-domain.de

# --- Phase-1-Login (optional, standardmaessig AUS) ---------------------------
# Schalter fuer den Login: "1" aktiviert Login-Pflicht + Identitaets-Verdrahtung
# (Chris sieht seine Teams, Franky seine). Leer/unset lassen, um den Login
# ausgeschaltet zu lassen - die App laeuft dann wie bisher ohne Anmeldung.
OLY_AUTH_ENABLED=

# Geheimer Schluessel zum Signieren der Session-Cookies. Zufaelligen, langen
# String erzeugen (z. B. `openssl rand -hex 32`) und geheim halten. Sobald
# OLY_AUTH_ENABLED=1 gesetzt ist, ist dieser Wert auf dem Server PFLICHT.
OLY_AUTH_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen

# Passwoerter fuer die zwei festen Benutzer Chris und Franky. Sobald
# OLY_AUTH_ENABLED=1 gesetzt ist, sind diese Werte auf dem Server PFLICHT -
# ohne sie schlaegt der Login fehl (kein unsicherer Default in Produktion).
OLY_USER_CHRIS_PASSWORD=bitte-echtes-passwort-setzen
OLY_USER_FRANKY_PASSWORD=bitte-echtes-passwort-setzen

# --- Lord Enterich Cards (LEC) ----------------------------------------------
# Eigene Subdomain, getrennt von der Oly. Caddy macht HTTPS automatisch.
LEC_DOMAIN=leccards.duckdns.org

# Zugangsschutz LEC (Single-User "Chris"). In Produktion ist der Login an
# (LEC_AUTH_ENABLED default 1 im compose). Beide Werte sind dann PFLICHT -
# ohne sie sperrt sich die App (fail closed, kein unsicherer Default).
# Session-Cookie ist langlebig (~1 Jahr): einmal pro Geraet anmelden.
LEC_AUTH_ENABLED=1
LEC_PASSWORD=bitte-echtes-passwort-setzen
LEC_AUTH_SECRET=bitte-mit-openssl-rand-hex-32-ersetzen


# Arena-Vorlauf (optional, PR #1290): die zwei Liga-Stufen einer Arena-Disziplin laufen standardmaessig
# gleichzeitig (zwei Chromium-Prozesse, lokal ~2 GB RAM). OLY_ARENA_TIER_PARALLEL=0 schaltet zurueck
# auf einen Browser zur Zeit. Unabhaengig davon faellt der Code automatisch auf seriell zurueck, wenn
# beim Start weniger als OLY_ARENA_TIER_PARALLEL_MIN_FREE_MB (Standard 2048) frei sind; 0 schaltet
# diese Pruefung ab. Wirkt erst nach einem Neustart des oly-app-Containers (z. B. naechster Deploy).
OLY_ARENA_TIER_PARALLEL=
OLY_ARENA_TIER_PARALLEL_MIN_FREE_MB=

# Mini-DM-FFA-Rollback (optional, Opus-Review an PR 5 des 6-PR-Opus-Plans 21.10.,
# "Vorlauf-Verdrahtung"): OLY_MINI_DM_FFA_VORLAUF=aus schaltet den Mini-DM-FFA-Vorlauf ab, der
# Spieltag faellt dann vollstaendig auf den alten PPS-Pod-Pfad zurueck. Leer/jeder andere Wert =
# Code-Standard (AN). Wirkt erst, nachdem der Container mit DIESEM `.env` neu ERSTELLT wurde
# (`docker compose up -d` im Repo-Verzeichnis auf dem Server) -- ein blosser `docker restart
# oly-app` reicht NICHT, weil er die beim letzten `docker compose up` eingefrorene Umgebung
# weiterverwendet und `.env` dafuer nicht neu einliest. Bereits mit `quelle:"ffa"` fertiggestellte
# Spieltage buchen nach dem Abschalten trotzdem mit diesem Ergebnis weiter (Snapshot-vorher,
# buchen-nachher, wie jede andere Arena-Disziplin).
OLY_MINI_DM_FFA_VORLAUF=
